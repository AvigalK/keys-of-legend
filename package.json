{
  "name": "keys-of-legend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gamified piano lessons that listen through the phone's microphone.",
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node tests/smoke.mjs",
    "check": "npm run lint && npm test && npm run test:smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "1.63.0"
  }
}
